# Optional. Set these and the app skips the login page; leave them out and it asks.
UNINTER_RU=00000000
UNINTER_PASSWORD=change-me
# Optional. Where the arquivos of the aulas land, one folder per matéria and aula.
UNINTER_AULAS_DIR=~/Uninter
# Optional. Where the student's Claude Code runs when the app opens it: its one conversation lives there, outside the repo.
UNINTER_CHAT_DIR=~/.local/share/uninter/chat
# Optional. Where the app serves its MCP server while it is open; the host must be 127.0.0.1 or localhost.
UNINTER_MCP_HOST=127.0.0.1
UNINTER_MCP_PORT=8765
# Read, never set by hand: the terminal the app runs in exports these, and `i` picks how to open Claude Code from them.
# TMUX= TMUX_PANE= ZELLIJ= WEZTERM_PANE= KITTY_WINDOW_ID= TERMINAL= DISPLAY= WAYLAND_DISPLAY=
