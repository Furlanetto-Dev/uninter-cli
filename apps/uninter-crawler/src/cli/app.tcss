Screen {
    layers: base;
}

MateriaList {
    width: 44;
    height: 1fr;
    border-right: solid $panel;
    padding: 1 1;
    background: $surface;
}

#detalhe {
    height: 1fr;
    padding: 1 2;
}

MateriaHeader {
    margin-bottom: 1;
}

MediaBar {
    margin-top: 1;
}

AtividadeTable {
    background: transparent;
}

AtividadeTable > .datatable--header {
    text-style: none;
    color: $text-muted;
    background: transparent;
}

#grades {
    height: auto;
}

DebugPanel {
    display: none;
}

Screen.-debug DebugPanel {
    display: block;
    height: 1fr;
    margin-top: 1;
}

Screen.-debug.-short #grades {
    display: none;
}

ConfirmarReset {
    align: center middle;
}

#confirmacao {
    width: 56;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}
