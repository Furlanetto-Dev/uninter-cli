Screen {
    layers: base;
}

MateriaList {
    width: 44;
    height: 1fr;
    border: none;
    border-right: solid $panel;
    padding: 1 1;
    background: $surface;
}

#detail {
    height: 1fr;
    padding: 1 2;
}

MateriaHeader {
    margin-bottom: 1;
}

MediaBar {
    margin-top: 1;
}

AtividadeTable {
    background: transparent;
}

AtividadeTable > .datatable--header {
    text-style: none;
    color: $text-muted;
    background: transparent;
}

#collections {
    height: auto;
}

DebugPanel {
    display: none;
}

Screen.-debug DebugPanel {
    display: block;
    height: 1fr;
    margin-top: 1;
}

Screen.-debug.-short #collections {
    display: none;
}

#debug-meta {
    height: auto;
    margin-bottom: 1;
}

#debug-columns {
    height: 1fr;
}

DebugColumn {
    width: 1fr;
    padding: 0 1;
    border: round $panel;
}

DebugColumn:focus,
DebugColumn:focus-within {
    border: round $border;
}

FieldsTable {
    background: transparent;
}

FieldsTable > .datatable--odd-row {
    background: $foreground 8%;
}

ConfirmReset {
    align: center middle;
}

#confirmation {
    width: 56;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}
