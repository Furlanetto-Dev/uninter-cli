Screen {
    layers: base;
}

/* A widget's DEFAULT_CSS is scoped to itself and cannot select its screen's classes. */
Screen.-debug.-short DebugPanel {
    margin-top: 0;
}

Screen.-debug.-short DetailHeader {
    margin-bottom: 0;
}

Screen.-debug.-short #debug-meta {
    margin-bottom: 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
