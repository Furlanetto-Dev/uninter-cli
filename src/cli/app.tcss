Screen {
    layers: base;
}

MateriaList {
    width: 44;
    height: 1fr;
    border: none;
    border-right: solid $panel;
    padding: 1 1;
    background: $surface;
}

#detail {
    height: 1fr;
    padding: 1 2;
}

MateriaHeader {
    margin-bottom: 1;
}

MediaBar {
    margin-top: 1;
}

AtividadeTree, TrabalhoTable {
    background: transparent;
}

AtividadeTree {
    height: auto;
    max-height: 100%;
}

AtividadeHeader {
    margin-bottom: 0;
}

TrabalhoTable > .datatable--header {
    text-style: none;
    color: $text-muted;
    background: transparent;
}

#collections {
    height: auto;
}

TabPane.-loading {
    min-height: 7;
}

DebugPanel {
    display: none;
}

Screen.-debug DebugPanel {
    display: block;
    height: 1fr;
    margin-top: 1;
}

Screen.-debug.-short #detail {
    padding: 0 2;
}

Screen.-debug.-short MateriaHeader {
    margin-bottom: 0;
}

Screen.-debug.-short AtividadeTree,
Screen.-debug.-short TrabalhoTable {
    max-height: 6;
}

Screen.-debug.-short DebugPanel {
    margin-top: 0;
}

Screen.-debug.-short #debug-meta {
    margin-bottom: 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#debug-meta {
    height: auto;
    margin-bottom: 1;
}

#debug-columns {
    height: 1fr;
}

DebugColumn {
    width: 1fr;
    padding: 0 1;
    border: round $panel;
}

DebugColumn:focus,
DebugColumn:focus-within {
    border: round $border;
}

FieldsTable {
    background: transparent;
}

FieldsTable > .datatable--odd-row {
    background: $foreground 8%;
}

ConfirmReset {
    align: center middle;
}

#confirmation {
    width: 56;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

ConfirmStart {
    align: center middle;
}

#start-confirmation {
    width: 76;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#start-answers {
    height: auto;
    margin-top: 1;
}

#start-answers Button {
    min-width: 0;
    width: auto;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: $surface;
    color: $foreground;
    border: round $foreground 15%;
    text-style: none;
}

#start-answers Button:focus {
    border: round $foreground;
    background-tint: transparent;
    text-style: none;
}
